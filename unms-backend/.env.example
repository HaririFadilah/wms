NODE_ENV=development
PORT=3001
APP_NAME=UNMS Billing API
API_PREFIX=api/v1

# CORS
CORS_ORIGINS=http://localhost:3000

# Database (akan dipakai pada BE-0003 Prisma setup)
DATABASE_URL=mysql://root:root@127.0.0.1:3306/unms

# Redis (akan dipakai pada Sprint berikut)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth (BE-0201) — secrets MUST be rotated for non-dev environments
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32-chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32-chars-min
JWT_ACCESS_TTL=900       # 15 minutes
JWT_REFRESH_TTL=604800   # 7 days
BCRYPT_ROUNDS=10

# Logging
LOG_LEVEL=info
