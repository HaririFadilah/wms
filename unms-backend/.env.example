NODE_ENV=development
PORT=3001
APP_NAME=UNMS Billing API
API_PREFIX=api/v1

# CORS
CORS_ORIGINS=http://localhost:3000

# Database (akan dipakai pada BE-0003 Prisma setup)
DATABASE_URL=mysql://root:root@127.0.0.1:3306/unms

# Redis (akan dipakai pada Sprint berikut)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth (akan dipakai pada BE-0201)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Logging
LOG_LEVEL=info
