// UNMS Billing System - Prisma schema (BE-0004 full domain)
//
// Sections:
//   1. System (settings, counters, job_logs, audit_logs, notification_logs)
//   2. Auth & RBAC (users, roles, permissions, role_permissions, password_reset_tokens)
//   3. Customer (customers, customer_addresses)
//   4. Catalog (packages, payment_channels)
//   5. Service (services, service_provisioning_logs)
//   6. Billing (invoices, invoice_items, transactions)
//   7. Network (routers, radius_profiles, radius_users)
//   8. FreeRadius (radcheck, radreply, radusergroup, radgroupcheck, radgroupreply,
//                  radacct, radpostauth, nas)
//   9. Ticketing (tickets, ticket_updates)
//  10. Summary tables for dashboard at 500k+ scale
//      (customer_search_index, service_status_snapshots, invoice_summary_monthly,
//       revenue_summary_daily, radius_usage_daily,
//       radius_active_sessions_snapshot, radius_nas_summary)

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native"]
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. SYSTEM
// ============================================================================

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(120)
  value     String   @db.Text
  group     String?  @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model SystemCounter {
  id           Int      @id @default(autoincrement())
  key          String   @unique @db.VarChar(120)
  currentValue BigInt   @default(0) @map("current_value")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("system_counters")
}

enum JobStatus {
  pending
  running
  success
  failed
  retrying
  cancelled

  @@map("job_status")
}

model JobLog {
  id             BigInt    @id @default(autoincrement())
  queue          String    @db.VarChar(60)
  jobName        String    @map("job_name") @db.VarChar(120)
  idempotencyKey String?   @unique @map("idempotency_key") @db.VarChar(160)
  status         JobStatus @default(pending)
  attempt        Int       @default(0)
  payload        Json?
  error          String?   @db.Text
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([queue, status])
  @@index([jobName, status])
  @@index([createdAt])
  @@map("job_logs")
}

enum AuditAction {
  create
  update
  delete
  read
  login
  logout
  permission_change
  password_change
  provisioning
  payment
  manual_override

  @@map("audit_action")
}

model AuditLog {
  id          BigInt      @id @default(autoincrement())
  actorUserId BigInt?     @map("actor_user_id")
  actorLabel  String?     @map("actor_label") @db.VarChar(120)
  action      AuditAction
  entityType  String      @map("entity_type") @db.VarChar(80)
  entityId    String?     @map("entity_id") @db.VarChar(120)
  ipAddress   String?     @map("ip_address") @db.VarChar(64)
  userAgent   String?     @map("user_agent") @db.VarChar(255)
  changes     Json?
  metadata    Json?
  requestId   String?     @map("request_id") @db.VarChar(64)
  createdAt   DateTime    @default(now()) @map("created_at")

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

enum NotificationChannel {
  email
  whatsapp
  sms
  in_app
  webhook

  @@map("notification_channel")
}

enum NotificationStatus {
  queued
  sent
  failed
  delivered
  read

  @@map("notification_status")
}

model NotificationLog {
  id          BigInt              @id @default(autoincrement())
  channel     NotificationChannel
  template    String              @db.VarChar(120)
  target      String              @db.VarChar(160)
  customerId  BigInt?             @map("customer_id")
  serviceId   BigInt?             @map("service_id")
  invoiceId   BigInt?             @map("invoice_id")
  ticketId    BigInt?             @map("ticket_id")
  status      NotificationStatus  @default(queued)
  payload     Json?
  providerRef String?             @map("provider_ref") @db.VarChar(160)
  error       String?             @db.Text
  sentAt      DateTime?           @map("sent_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  ticket   Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([channel, status])
  @@index([customerId, createdAt])
  @@index([createdAt])
  @@map("notification_logs")
}

// ============================================================================
// 2. AUTH & RBAC
// ============================================================================

enum UserStatus {
  active
  inactive
  suspended

  @@map("user_status")
}

model User {
  id                  BigInt     @id @default(autoincrement())
  email               String     @unique @db.VarChar(160)
  username            String     @unique @db.VarChar(80)
  passwordHash        String     @map("password_hash") @db.VarChar(255)
  fullName            String     @map("full_name") @db.VarChar(160)
  phone               String?    @db.VarChar(40)
  status              UserStatus @default(active)
  lastLoginAt         DateTime?  @map("last_login_at")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  roles               UserRole[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  ticketAssignments   Ticket[]             @relation("TicketAssignee")
  ticketCreator       Ticket[]             @relation("TicketCreatedBy")
  ticketUpdates       TicketUpdate[]
  customerOwner       Customer[]           @relation("CustomerOwner")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(60)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(255)
  group       String?  @db.VarChar(60)
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([group])
  @@map("permissions")
}

model UserRole {
  userId    BigInt   @map("user_id")
  roleId    Int      @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ============================================================================
// 3. CUSTOMER
// ============================================================================

enum CustomerStatus {
  active
  inactive
  prospect
  banned

  @@map("customer_status")
}

enum CustomerSegment {
  residential
  smb
  corporate
  reseller

  @@map("customer_segment")
}

model Customer {
  id           BigInt          @id @default(autoincrement())
  customerCode String          @unique @map("customer_code") @db.VarChar(20)
  fullName     String          @map("full_name") @db.VarChar(160)
  email        String?         @db.VarChar(160)
  phone        String          @db.VarChar(40)
  whatsapp     String?         @db.VarChar(40)
  nationalId   String?         @map("national_id") @db.VarChar(40)
  status       CustomerStatus  @default(active)
  segment      CustomerSegment @default(residential)
  ownerUserId  BigInt?         @map("owner_user_id")
  joinedAt     DateTime?       @map("joined_at")
  metadata     Json?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  deletedAt    DateTime?       @map("deleted_at")

  owner         User?                @relation("CustomerOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  addresses     CustomerAddress[]
  services      Service[]
  invoices      Invoice[]
  transactions  Transaction[]
  tickets       Ticket[]
  notifications NotificationLog[]
  searchIndex   CustomerSearchIndex?

  @@index([status])
  @@index([phone])
  @@index([email])
  @@index([createdAt])
  @@index([segment, status])
  @@map("customers")
}

model CustomerAddress {
  id          BigInt   @id @default(autoincrement())
  customerId  BigInt   @map("customer_id")
  label       String   @db.VarChar(60)
  addressLine String   @map("address_line") @db.VarChar(255)
  rt          String?  @db.VarChar(10)
  rw          String?  @db.VarChar(10)
  village     String?  @db.VarChar(80)
  district    String?  @db.VarChar(80)
  city        String?  @db.VarChar(80)
  province    String?  @db.VarChar(80)
  postalCode  String?  @map("postal_code") @db.VarChar(20)
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isPrimary])
  @@index([city])
  @@map("customer_addresses")
}

// ============================================================================
// 4. CATALOG
// ============================================================================

enum PackageStatus {
  active
  inactive

  @@map("package_status")
}

model Package {
  id              Int           @id @default(autoincrement())
  code            String        @unique @db.VarChar(40)
  name            String        @db.VarChar(120)
  description     String?       @db.VarChar(500)
  speedUpMbps     Int           @map("speed_up_mbps")
  speedDownMbps   Int           @map("speed_down_mbps")
  price           Decimal       @db.Decimal(12, 2)
  taxPercent      Decimal       @default(0) @map("tax_percent") @db.Decimal(5, 2)
  radiusProfileId Int?          @map("radius_profile_id")
  status          PackageStatus @default(active)
  metadata        Json?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  radiusProfile RadiusProfile? @relation(fields: [radiusProfileId], references: [id], onDelete: SetNull)
  services      Service[]

  @@index([status])
  @@map("packages")
}

enum PaymentChannelType {
  va
  qris
  ewallet
  bank_transfer
  cash
  other

  @@map("payment_channel_type")
}

model PaymentChannel {
  id         Int                @id @default(autoincrement())
  code       String             @unique @db.VarChar(60)
  name       String             @db.VarChar(120)
  type       PaymentChannelType
  provider   String?            @db.VarChar(80)
  feeFlat    Decimal            @default(0) @map("fee_flat") @db.Decimal(12, 2)
  feePercent Decimal            @default(0) @map("fee_percent") @db.Decimal(5, 2)
  isActive   Boolean            @default(true) @map("is_active")
  config     Json?
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  transactions Transaction[]

  @@map("payment_channels")
}

// ============================================================================
// 5. SERVICE
// ============================================================================

enum ServiceStatus {
  draft
  pending_activation
  active
  suspended
  expired
  terminated
  failed_provisioning

  @@map("service_status")
}

enum ProvisioningMode {
  api
  radius

  @@map("provisioning_mode")
}

enum ProvisioningStatus {
  pending
  success
  failed
  retrying
  skipped

  @@map("provisioning_status")
}

model Service {
  id                    BigInt             @id @default(autoincrement())
  customerId            BigInt             @map("customer_id")
  packageId             Int                @map("package_id")
  routerId              Int?               @map("router_id")
  pppoeUsername         String             @unique @map("pppoe_username") @db.VarChar(120)
  pppoePasswordHash     String             @map("pppoe_password_hash") @db.VarChar(255)
  provisioningMode      ProvisioningMode   @default(radius) @map("provisioning_mode")
  provisioningStatus    ProvisioningStatus @default(pending) @map("provisioning_status")
  status                ServiceStatus      @default(draft)
  installationAddressId BigInt?            @map("installation_address_id")
  ipAddress             String?            @map("ip_address") @db.VarChar(64)
  macAddress            String?            @map("mac_address") @db.VarChar(40)
  activatedAt           DateTime?          @map("activated_at")
  expiredAt             DateTime?          @map("expired_at")
  suspendedAt           DateTime?          @map("suspended_at")
  terminatedAt          DateTime?          @map("terminated_at")
  dueDay                Int                @default(1) @map("due_day")
  basePrice             Decimal            @map("base_price") @db.Decimal(12, 2)
  notes                 String?            @db.Text
  metadata              Json?
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  deletedAt             DateTime?          @map("deleted_at")

  customer         Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  package          Package                  @relation(fields: [packageId], references: [id], onDelete: Restrict)
  router           Router?                  @relation(fields: [routerId], references: [id], onDelete: SetNull)
  provisioningLogs ServiceProvisioningLog[]
  invoices         Invoice[]
  notifications    NotificationLog[]
  tickets          Ticket[]
  statusSnapshot   ServiceStatusSnapshot?
  radiusUser       RadiusUser?

  @@index([customerId])
  @@index([status])
  @@index([routerId])
  @@index([packageId])
  @@index([expiredAt])
  @@index([dueDay])
  @@index([provisioningStatus])
  @@map("services")
}

model ServiceProvisioningLog {
  id          BigInt             @id @default(autoincrement())
  serviceId   BigInt             @map("service_id")
  action      String             @db.VarChar(80)
  mode        ProvisioningMode
  status      ProvisioningStatus
  attempt     Int                @default(1)
  payload     Json?
  response    Json?
  error       String?            @db.Text
  durationMs  Int?               @map("duration_ms")
  triggeredBy BigInt?            @map("triggered_by")
  jobId       String?            @map("job_id") @db.VarChar(120)
  createdAt   DateTime           @default(now()) @map("created_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, createdAt])
  @@index([status, createdAt])
  @@index([action])
  @@map("service_provisioning_logs")
}

// ============================================================================
// 6. BILLING
// ============================================================================

enum InvoiceStatus {
  draft
  unpaid
  partially_paid
  paid
  cancelled
  overdue

  @@map("invoice_status")
}

model Invoice {
  id            BigInt        @id @default(autoincrement())
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(40)
  customerId    BigInt        @map("customer_id")
  serviceId     BigInt?       @map("service_id")
  periodMonth   Int           @map("period_month")
  periodYear    Int           @map("period_year")
  issueDate     DateTime      @map("issue_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  subtotal      Decimal       @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  tax           Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @db.Decimal(14, 2)
  amountPaid    Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  status        InvoiceStatus @default(unpaid)
  notes         String?       @db.Text
  metadata      Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  paidAt        DateTime?     @map("paid_at")
  cancelledAt   DateTime?     @map("cancelled_at")

  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service       Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]
  transactions  Transaction[]
  notifications NotificationLog[]

  @@index([customerId, status])
  @@index([serviceId])
  @@index([status, dueDate])
  @@index([dueDate])
  @@index([periodYear, periodMonth])
  @@map("invoices")
}

model InvoiceItem {
  id          BigInt   @id @default(autoincrement())
  invoiceId   BigInt   @map("invoice_id")
  description String   @db.VarChar(255)
  quantity    Int      @default(1)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(14, 2)
  discount    Decimal  @default(0) @db.Decimal(14, 2)
  total       Decimal  @db.Decimal(14, 2)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

enum TransactionStatus {
  pending
  success
  failed
  reversed
  expired

  @@map("transaction_status")
}

model Transaction {
  id               BigInt            @id @default(autoincrement())
  transactionCode  String            @unique @map("transaction_code") @db.VarChar(60)
  customerId       BigInt?           @map("customer_id")
  invoiceId        BigInt?           @map("invoice_id")
  paymentChannelId Int               @map("payment_channel_id")
  amount           Decimal           @db.Decimal(14, 2)
  fee              Decimal           @default(0) @db.Decimal(14, 2)
  netAmount        Decimal           @map("net_amount") @db.Decimal(14, 2)
  status           TransactionStatus @default(pending)
  gatewayRef       String?           @unique @map("gateway_ref") @db.VarChar(160)
  rawPayload       Json?             @map("raw_payload")
  paidAt           DateTime?         @map("paid_at")
  expiresAt        DateTime?         @map("expires_at")
  reversedAt       DateTime?         @map("reversed_at")
  notes            String?           @db.Text
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentChannel PaymentChannel @relation(fields: [paymentChannelId], references: [id], onDelete: Restrict)

  @@index([customerId, status])
  @@index([invoiceId])
  @@index([status, createdAt])
  @@index([paidAt])
  @@map("transactions")
}

// ============================================================================
// 7. NETWORK
// ============================================================================

enum RouterStatus {
  active
  inactive
  maintenance

  @@map("router_status")
}

model Router {
  id                Int          @id @default(autoincrement())
  name              String       @db.VarChar(120)
  identifier        String       @unique @db.VarChar(120)
  host              String       @db.VarChar(120)
  apiPort           Int          @default(8728) @map("api_port")
  username          String       @db.VarChar(80)
  passwordEncrypted String       @map("password_encrypted") @db.VarChar(500)
  location          String?      @db.VarChar(160)
  status            RouterStatus @default(active)
  metadata          Json?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  services Service[]
  nas      Nas[]

  @@index([status])
  @@map("routers")
}

model RadiusProfile {
  id             Int      @id @default(autoincrement())
  name           String   @unique @db.VarChar(80)
  groupname      String   @unique @db.VarChar(80)
  speedUpMbps    Int      @map("speed_up_mbps")
  speedDownMbps  Int      @map("speed_down_mbps")
  pool           String?  @db.VarChar(80)
  sessionTimeout Int?     @map("session_timeout")
  idleTimeout    Int?     @map("idle_timeout")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  packages Package[]

  @@map("radius_profiles")
}

model RadiusUser {
  id         BigInt    @id @default(autoincrement())
  serviceId  BigInt    @unique @map("service_id")
  username   String    @unique @db.VarChar(120)
  groupname  String?   @db.VarChar(80)
  enabled    Boolean   @default(true)
  lastSyncAt DateTime? @map("last_sync_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([groupname])
  @@map("radius_users")
}

// ============================================================================
// 8. FreeRadius standard tables
// (FreeRadius default schema for MySQL. Managed by RadiusProvisioningService.)
// ============================================================================

model RadCheck {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  username  String @default("") @db.VarChar(64)
  attribute String @default("") @db.VarChar(64)
  op        String @default("==") @db.Char(2)
  value     String @default("") @db.VarChar(253)

  @@index([username], map: "username")
  @@map("radcheck")
}

model RadReply {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  username  String @default("") @db.VarChar(64)
  attribute String @default("") @db.VarChar(64)
  op        String @default("=") @db.Char(2)
  value     String @default("") @db.VarChar(253)

  @@index([username], map: "username")
  @@map("radreply")
}

model RadUserGroup {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  username  String @default("") @db.VarChar(64)
  groupname String @default("") @db.VarChar(64)
  priority  Int    @default(1)

  @@index([username], map: "username")
  @@map("radusergroup")
}

model RadGroupCheck {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  groupname String @default("") @db.VarChar(64)
  attribute String @default("") @db.VarChar(64)
  op        String @default("==") @db.Char(2)
  value     String @default("") @db.VarChar(253)

  @@index([groupname], map: "groupname")
  @@map("radgroupcheck")
}

model RadGroupReply {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  groupname String @default("") @db.VarChar(64)
  attribute String @default("") @db.VarChar(64)
  op        String @default("=") @db.Char(2)
  value     String @default("") @db.VarChar(253)

  @@index([groupname], map: "groupname")
  @@map("radgroupreply")
}

model RadAcct {
  radacctid           BigInt    @id @default(autoincrement())
  acctsessionid       String    @default("") @db.VarChar(64)
  acctuniqueid        String    @unique @default("") @db.VarChar(32)
  username            String    @default("") @db.VarChar(64)
  groupname           String    @default("") @db.VarChar(64)
  realm               String?   @db.VarChar(64)
  nasipaddress        String    @default("") @db.VarChar(15)
  nasportid           String?   @db.VarChar(15)
  nasporttype         String?   @db.VarChar(32)
  acctstarttime       DateTime? @db.DateTime(0)
  acctupdatetime      DateTime? @db.DateTime(0)
  acctstoptime        DateTime? @db.DateTime(0)
  acctinterval        Int?
  acctsessiontime     Int?      @db.UnsignedInt
  acctauthentic       String?   @db.VarChar(32)
  connectinfo_start   String?   @db.VarChar(50)
  connectinfo_stop    String?   @db.VarChar(50)
  acctinputoctets     BigInt?
  acctoutputoctets    BigInt?
  calledstationid     String    @default("") @db.VarChar(50)
  callingstationid    String    @default("") @db.VarChar(50)
  acctterminatecause  String    @default("") @db.VarChar(32)
  servicetype         String?   @db.VarChar(32)
  framedprotocol      String?   @db.VarChar(32)
  framedipaddress     String    @default("") @db.VarChar(15)
  framedipv6address   String    @default("") @db.VarChar(45)
  framedipv6prefix    String    @default("") @db.VarChar(45)
  framedinterfaceid   String    @default("") @db.VarChar(44)
  delegatedipv6prefix String    @default("") @db.VarChar(45)
  classAttr           String?   @map("class") @db.VarChar(64)

  @@index([username, acctstarttime], map: "username")
  @@index([framedipaddress], map: "framedipaddress")
  @@index([framedipv6address], map: "framedipv6address")
  @@index([framedipv6prefix], map: "framedipv6prefix")
  @@index([framedinterfaceid], map: "framedinterfaceid")
  @@index([delegatedipv6prefix], map: "delegatedipv6prefix")
  @@index([acctsessionid], map: "acctsessionid")
  @@index([acctstoptime, nasipaddress, acctuniqueid], map: "acctstoptime")
  @@index([acctstarttime], map: "acctstarttime")
  @@index([acctinterval], map: "acctinterval")
  @@index([acctstoptime], map: "acctstoptime_idx")
  @@index([nasipaddress], map: "nasipaddress")
  @@map("radacct")
}

model RadPostAuth {
  id        Int      @id @default(autoincrement())
  username  String   @default("") @db.VarChar(64)
  pass      String   @default("") @db.VarChar(64)
  reply     String   @default("") @db.VarChar(32)
  authdate  DateTime @default(now()) @db.Timestamp(6)
  classAttr String?  @map("class") @db.VarChar(64)

  @@index([username, authdate], map: "username")
  @@map("radpostauth")
}

model Nas {
  id          Int     @id @default(autoincrement())
  nasname     String  @default("") @db.VarChar(128)
  shortname   String? @db.VarChar(32)
  type        String  @default("other") @db.VarChar(30)
  ports       Int?
  secret      String  @default("secret") @db.VarChar(60)
  server      String? @db.VarChar(64)
  community   String? @db.VarChar(50)
  description String? @default("RADIUS Client") @db.VarChar(200)
  routerId    Int?    @map("router_id")

  router Router? @relation(fields: [routerId], references: [id], onDelete: SetNull)

  @@index([nasname], map: "nasname")
  @@map("nas")
}

// ============================================================================
// 9. TICKETING
// ============================================================================

enum TicketStatus {
  open
  in_progress
  pending_customer
  resolved
  closed
  cancelled

  @@map("ticket_status")
}

enum TicketPriority {
  low
  normal
  high
  urgent

  @@map("ticket_priority")
}

enum TicketCategory {
  installation
  network_issue
  billing_inquiry
  service_change
  termination
  other

  @@map("ticket_category")
}

model Ticket {
  id           BigInt         @id @default(autoincrement())
  ticketNumber String         @unique @map("ticket_number") @db.VarChar(40)
  customerId   BigInt         @map("customer_id")
  serviceId    BigInt?        @map("service_id")
  subject      String         @db.VarChar(255)
  category     TicketCategory
  priority     TicketPriority @default(normal)
  status       TicketStatus   @default(open)
  assigneeId   BigInt?        @map("assignee_id")
  createdById  BigInt?        @map("created_by_id")
  resolvedAt   DateTime?      @map("resolved_at")
  closedAt     DateTime?      @map("closed_at")
  slaDueAt     DateTime?      @map("sla_due_at")
  metadata     Json?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service       Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  assignee      User?             @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy     User?             @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updates       TicketUpdate[]
  notifications NotificationLog[]

  @@index([customerId, status])
  @@index([serviceId])
  @@index([status, priority])
  @@index([assigneeId, status])
  @@index([slaDueAt])
  @@map("tickets")
}

enum TicketUpdateType {
  comment
  status_change
  assignment_change
  attachment
  internal_note

  @@map("ticket_update_type")
}

model TicketUpdate {
  id         BigInt           @id @default(autoincrement())
  ticketId   BigInt           @map("ticket_id")
  authorId   BigInt?          @map("author_id")
  type       TicketUpdateType @default(comment)
  body       String?          @db.Text
  fromValue  String?          @map("from_value") @db.VarChar(120)
  toValue    String?          @map("to_value") @db.VarChar(120)
  visibility String           @default("public") @db.VarChar(20)
  metadata   Json?
  createdAt  DateTime         @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_updates")
}

// ============================================================================
// 10. SUMMARY TABLES (denormalized for dashboard / 500k+ scale)
// ============================================================================

model CustomerSearchIndex {
  customerId         BigInt    @id @map("customer_id")
  customerCode       String    @map("customer_code") @db.VarChar(20)
  fullName           String    @map("full_name") @db.VarChar(160)
  phone              String    @db.VarChar(40)
  email              String?   @db.VarChar(160)
  status             String    @db.VarChar(20)
  segment            String    @db.VarChar(20)
  city               String?   @db.VarChar(80)
  activeServiceCount Int       @default(0) @map("active_service_count")
  totalOutstanding   Decimal   @default(0) @map("total_outstanding") @db.Decimal(14, 2)
  lastInvoiceAt      DateTime? @map("last_invoice_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerCode])
  @@index([phone])
  @@index([status, city])
  @@index([updatedAt])
  @@fulltext([fullName, phone, email, customerCode])
  @@map("customer_search_index")
}

model ServiceStatusSnapshot {
  serviceId          BigInt    @id @map("service_id")
  customerId         BigInt    @map("customer_id")
  status             String    @db.VarChar(30)
  provisioningStatus String    @map("provisioning_status") @db.VarChar(30)
  pppoeUsername      String    @map("pppoe_username") @db.VarChar(120)
  packageId          Int       @map("package_id")
  routerId           Int?      @map("router_id")
  lastOnlineAt       DateTime? @map("last_online_at")
  lastOfflineAt      DateTime? @map("last_offline_at")
  expiredAt          DateTime? @map("expired_at")
  unpaidInvoiceCount Int       @default(0) @map("unpaid_invoice_count")
  unpaidTotal        Decimal   @default(0) @map("unpaid_total") @db.Decimal(14, 2)
  updatedAt          DateTime  @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@index([routerId, status])
  @@index([expiredAt])
  @@map("service_status_snapshots")
}

model InvoiceSummaryMonthly {
  id               BigInt   @id @default(autoincrement())
  periodYear       Int      @map("period_year")
  periodMonth      Int      @map("period_month")
  totalInvoices    Int      @default(0) @map("total_invoices")
  totalAmount      Decimal  @default(0) @map("total_amount") @db.Decimal(16, 2)
  totalPaid        Decimal  @default(0) @map("total_paid") @db.Decimal(16, 2)
  totalOutstanding Decimal  @default(0) @map("total_outstanding") @db.Decimal(16, 2)
  paidInvoices     Int      @default(0) @map("paid_invoices")
  overdueInvoices  Int      @default(0) @map("overdue_invoices")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([periodYear, periodMonth])
  @@index([periodYear])
  @@map("invoice_summary_monthly")
}

model RevenueSummaryDaily {
  date             DateTime @id @db.Date
  totalRevenue     Decimal  @default(0) @map("total_revenue") @db.Decimal(16, 2)
  transactionCount Int      @default(0) @map("transaction_count")
  feeTotal         Decimal  @default(0) @map("fee_total") @db.Decimal(14, 2)
  netRevenue       Decimal  @default(0) @map("net_revenue") @db.Decimal(16, 2)
  newCustomers     Int      @default(0) @map("new_customers")
  newServices      Int      @default(0) @map("new_services")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("revenue_summary_daily")
}

model RadiusUsageDaily {
  id              BigInt   @id @default(autoincrement())
  serviceId       BigInt   @map("service_id")
  date            DateTime @db.Date
  uploadBytes     BigInt   @default(0) @map("upload_bytes")
  downloadBytes   BigInt   @default(0) @map("download_bytes")
  sessionCount    Int      @default(0) @map("session_count")
  totalSessionSec Int      @default(0) @map("total_session_sec")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([serviceId, date])
  @@index([date])
  @@map("radius_usage_daily")
}

model RadiusActiveSessionsSnapshot {
  id            BigInt   @id @default(autoincrement())
  routerId      Int?     @map("router_id")
  totalSessions Int      @default(0) @map("total_sessions")
  uniqueUsers   Int      @default(0) @map("unique_users")
  capturedAt    DateTime @default(now()) @map("captured_at")

  @@index([routerId, capturedAt])
  @@index([capturedAt])
  @@map("radius_active_sessions_snapshot")
}

model RadiusNasSummary {
  nasIp              String    @id @map("nas_ip") @db.VarChar(45)
  shortname          String?   @db.VarChar(32)
  activeSessions     Int       @default(0) @map("active_sessions")
  uniqueUsers        Int       @default(0) @map("unique_users")
  totalSessionsToday Int       @default(0) @map("total_sessions_today")
  lastSeenAt         DateTime? @map("last_seen_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("radius_nas_summary")
}
